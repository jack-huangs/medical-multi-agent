        <mxCell id="89-dd3Uj0iwIXqgljjeS-108" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=default;fontStyle=1;fontSize=18;strokeWidth=3;" value="Create Group instance for every parsed MDT&lt;br&gt;为每个 MDT 创建 Group 对象" vertex="1">
          <mxGeometry height="60" width="420" x="-678.3333333333333" y="-528.3333333333333" as="geometry" />
