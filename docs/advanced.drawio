        <mxCell id="89-dd3Uj0iwIXqgljjeS-101" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;strokeWidth=3;strokeColor=default;" value="MDAgents — Advanced / 高难度题目处理流程" vertex="1">
