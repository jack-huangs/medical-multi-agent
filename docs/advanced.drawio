        <mxCell id="89-dd3Uj0iwIXqgljjeS-109" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=default;align=left;spacingLeft=8;spacingRight=8;fontSize=18;fontStyle=1;strokeWidth=3;" value="Create 3 member Agents / 创建成员智能体&lt;br&gt;&lt;i&gt;You are a {role} who {expertise_description}.&lt;/i&gt;" vertex="1">
          <mxGeometry height="75" width="420" x="-678.3333333333333" y="-433.33333333333326" as="geometry" />
