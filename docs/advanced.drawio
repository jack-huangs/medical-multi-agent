        <mxCell id="89-dd3Uj0iwIXqgljjeS-102" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#dae8fc;swimlaneFillColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=18;strokeWidth=3;strokeColor=#000000;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;1. MDT RECRUITMENT / 多学科团队招募&lt;/span&gt;" vertex="1">
          <mxGeometry height="543.33" width="480" x="-1223.33" y="-583.33" as="geometry" />
        </mxCell>
        <mxCell id="89-dd3Uj0iwIXqgljjeS-103" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=default;fontStyle=1;fontSize=18;strokeWidth=3;" value="Input / 输入&lt;br&gt;复杂医学题目 + 选项" vertex="1">
          <mxGeometry height="50" width="420" x="-1193.3333333333333" y="-528.3333333333333" as="geometry" />
        </mxCell>
        <mxCell id="89-dd3Uj0iwIXqgljjeS-104" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=default;align=left;spacingLeft=8;spacingRight=8;fontSize=18;fontStyle=1;strokeWidth=3;" value="Recruiter / 招募智能体&lt;br&gt;&lt;i&gt;You are an experienced medical expert... organize Multidisciplinary Teams (MDTs) and the members in MDT to make accurate and robust answer.&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="433.33" x="-1193.33" y="-468.33" as="geometry" />
        </mxCell>
        <mxCell id="89-dd3Uj0iwIXqgljjeS-105" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=default;align=left;spacingLeft=8;spacingRight=8;fontSize=18;fontStyle=1;strokeWidth=3;" value="&lt;span&gt;Recruitment prompt / 招募提示词&lt;/span&gt;&lt;br&gt;&lt;i&gt;Organize 3 MDTs with different specialties or purposes and 3 clinicians per MDT... include Initial Assessment Team (IAT) and Final Review and Decision Team (FRDT)... strictly refer to the requested Group / Member format.&lt;/i&gt;" vertex="1">
          <mxGeometry height="155" width="420" x="-1193.3333333333333" y="-323.33333333333326" as="geometry" />
        </mxCell>
        <mxCell id="89-dd3Uj0iwIXqgljjeS-106" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=default;fontStyle=1;fontSize=18;strokeWidth=3;" value="Parse output / 解析输出&lt;br&gt;Group goal + Members + role + expertise" vertex="1">
          <mxGeometry height="65" width="420" x="-1193.3333333333333" y="-128.33333333333326" as="geometry" />
        </mxCell>
        <mxCell id="89-dd3Uj0iwIXqgljjeS-107" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#d5e8d4;swimlaneFillColor=#82b366;fontColor=#ffffff;fontStyle=1;fontSize=18;strokeWidth=3;strokeColor=default;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;2. BUILD MDTs / 建立团队&lt;/span&gt;" vertex="1">
          <mxGeometry height="543.33" width="480" x="-708.33" y="-583.33" as="geometry" />
