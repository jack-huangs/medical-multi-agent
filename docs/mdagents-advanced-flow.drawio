<mxfile host="app.diagrams.net" modified="2026-09-16T00:00:00.000Z" agent="Codex" version="26.0.14">
  <diagram id="mdagents-advanced" name="Advanced flow">
    <mxGraphModel dx="2200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="MDAgents — Advanced / 高难度题目处理流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2100" height="35" as="geometry"/></mxCell>

        <mxCell id="s1" value="1. MDT RECRUITMENT / 多学科团队招募" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#dae8fc;swimlaneFillColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="480" height="660" as="geometry"/></mxCell>
        <mxCell id="a1" value="Input / 输入&lt;br&gt;复杂医学题目 + 选项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="420" height="50" as="geometry"/></mxCell>
        <mxCell id="a2" value="Recruiter / 招募智能体&lt;br&gt;&lt;i&gt;You are an experienced medical expert... organize Multidisciplinary Teams (MDTs) and the members in MDT to make accurate and robust answer.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Recruitment prompt / 招募提示词&lt;/b&gt;&lt;br&gt;&lt;i&gt;Organize 3 MDTs with different specialties or purposes and 3 clinicians per MDT... include Initial Assessment Team (IAT) and Final Review and Decision Team (FRDT)... strictly refer to the requested Group / Member format.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="325" width="420" height="155" as="geometry"/></mxCell>
        <mxCell id="a4" value="Parse output / 解析输出&lt;br&gt;Group goal + Members + role + expertise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="420" height="65" as="geometry"/></mxCell>

        <mxCell id="s2" value="2. BUILD MDTs / 建立团队" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#d5e8d4;swimlaneFillColor=#82b366;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="535" y="65" width="480" height="660" as="geometry"/></mxCell>
        <mxCell id="b1" value="Create Group instance for every parsed MDT&lt;br&gt;为每个 MDT 创建 Group 对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565" y="120" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="b2" value="Create 3 member Agents / 创建成员智能体&lt;br&gt;&lt;i&gt;You are a {role} who {expertise_description}.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="565" y="215" width="420" height="75" as="geometry"/></mxCell>
        <mxCell id="b3" value="Lead delegates investigations / 组长分派调查&lt;br&gt;&lt;i&gt;You are the lead... provide a short answer to what kind investigations are needed from each assistant clinician. Question: {question}&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="565" y="325" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="b4" value="Assistants investigate / 助理成员调查&lt;br&gt;&lt;i&gt;Your group lead is asking for the following investigations... return your investigation summary that contains the core information.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="565" y="480" width="420" height="100" as="geometry"/></mxCell>

        <mxCell id="s3" value="3. STAGED MDT EXECUTION / 分阶段团队执行" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#fff2cc;swimlaneFillColor=#d6b656;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1050" y="65" width="620" height="660" as="geometry"/></mxCell>
        <mxCell id="c1" value="2.1 Initial Assessment / 初始评估&lt;br&gt;运行 goal 含 initial 或 iap 的 MDT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="Collect initial_assessment_report&lt;br&gt;汇总初始评估报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="210" width="560" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="2.2 Specialist MDTs / 专科团队&lt;br&gt;运行非 initial、非 review / decision / frdt 的 MDT&lt;br&gt;代码传入 message=initial_assessment_report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1080" y="295" width="560" height="85" as="geometry"/></mxCell>
        <mxCell id="c4" value="2.3 Final Review / 最终审查团队&lt;br&gt;运行 goal 含 review、decision 或 frdt 的 MDT&lt;br&gt;代码传入 message=prior_reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1080" y="415" width="560" height="85" as="geometry"/></mxCell>
        <mxCell id="c5" value="Report propagation / 报告传递&lt;br&gt;initial_assessment_report 注入专科 MDT 的提示词；prior_reports 注入最终审查 MDT 的提示词。组长和成员均可看到前序报告及当前题目。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="545" width="560" height="90" as="geometry"/></mxCell>

        <mxCell id="s4" value="4. FINAL DECISION / 最终决策" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#f8cecc;swimlaneFillColor=#b85450;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1705" y="65" width="385" height="660" as="geometry"/></mxCell>
        <mxCell id="d1" value="Combine reports / 汇总报告&lt;br&gt;initial + specialist + final review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1735" y="120" width="325" height="60" as="geometry"/></mxCell>
        <mxCell id="d2" value="Decision maker / 最终决策智能体&lt;br&gt;&lt;i&gt;Review all MDT reports carefully and return the final decision to the medical query.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1735" y="215" width="325" height="100" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;Final prompt / 最终提示词&lt;/b&gt;&lt;br&gt;&lt;i&gt;Investigation reports from all MDT stages: {all_reports}&lt;br&gt;Question: {question}&lt;br&gt;Return one final, evidence-based answer.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1735" y="350" width="325" height="130" as="geometry"/></mxCell>
        <mxCell id="d4" value="Output / 输出&lt;br&gt;final response, temperature = 0.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1735" y="525" width="325" height="65" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
